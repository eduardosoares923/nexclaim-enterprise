rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function papel() {
      return request.auth.token.role;
    }
    function estaLogado() {
      return request.auth != null;
    }
    function ehProprietario() {
      return estaLogado() && papel() == 'PROPRIETARIO';
    }
    function ehAdminOuMais() {
      return estaLogado() && (papel() == 'PROPRIETARIO' || papel() == 'ADMINISTRADOR');
    }
    function podeCriarOuEditar() {
      return estaLogado() && papel() in ['PROPRIETARIO', 'ADMINISTRADOR', 'GESTOR', 'OPERADOR'];
    }
    function ehDono(dados) {
      return estaLogado() && dados.createdBy == request.auth.token.email;
    }

    match /systemUsers/{userId} {
      allow read, write: if ehProprietario();
    }

    match /{colecaoOperacional}/{docId} {
      allow read: if estaLogado();
      allow create: if podeCriarOuEditar();
      allow update: if ehAdminOuMais()
        || (papel() == 'GESTOR')
        || (papel() == 'OPERADOR' && ehDono(resource.data));
      allow delete: if ehAdminOuMais()
        || (papel() == 'OPERADOR' && ehDono(resource.data));
    }
  }
}
